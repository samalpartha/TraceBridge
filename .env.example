# TinyFish Web Agent
TINYFISH_API_KEY=sk-tinyfish-your-key-here

# LLM Provider (via LiteLLM)
OPENAI_API_KEY=sk-your-openai-key
LITELLM_MODEL=gpt-4o-mini

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://reunite:reunite@localhost:5432/reuniteai
DATABASE_URL_SYNC=postgresql://reunite:reunite@localhost:5432/reuniteai
POSTGRES_USER=reunite
POSTGRES_PASSWORD=reunite
POSTGRES_DB=reuniteai

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
